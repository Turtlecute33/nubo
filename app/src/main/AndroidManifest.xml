<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Filen API, upload and download hosts only (README lists them). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Job network constraints: transfers need a network, camera upload can wait for an unmetered one. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Transfer progress: counts and percentages only, never file names. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Transfers that the user starts go on when the user leaves the app (user-initiated data transfer job). -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <!-- Camera upload only, asked when the user turns it on. No media location access: Android removes the GPS
         position from the uploaded files. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Declared so that the app sees a "selected photos only" grant and can tell the user that camera upload
         needs full access. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Camera upload only: the system does not keep the camera upload job over a reboot, so the app schedules it
         again after the boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional app lock (strong biometric or the screen lock). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Hides the overlays of other apps while the login screen shows (a normal permission). -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <application
        android:name=".NuboApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:memtagMode="sync"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nubo"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share files to upload them, or share a Filen link to open it. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- Public Filen links. Not verified (Filen owns the domain): the user picks the app in the system
                 link settings. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="app.filen.io" />
                <data android:host="drive.filen.io" />
            </intent-filter>
        </activity>

        <service
            android:name=".transfer.TransferJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".work.CameraJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- NOT exported: only the system sends BOOT_COMPLETED to it. -->
        <receiver
            android:name=".work.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- "Open with" and "Send a copy": NOT exported. Another app reads only a URI that nubo granted to it
             in an intent; the data streams from a proxy file descriptor, with no plain copy on the disk. -->
        <provider
            android:name=".media.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- EmojiCompat would look for a downloadable emoji font (a Play Services font provider).
             Use the platform emoji font. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
